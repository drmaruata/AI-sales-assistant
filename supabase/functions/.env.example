# Local-only secrets for Supabase Edge Functions.
# Copy to .env and replace placeholders; never commit the .env file.
# Supabase injects its own SUPABASE_* variables. Do not define custom names
# beginning with SUPABASE_.
AI_PROVIDER_API_KEY=replace-with-a-local-test-key
AI_PROVIDER_MODEL=replace-with-an-approved-model
