# Mobile app public configuration only.
# Copy this file to .env and fill in the values for your Supabase project.
# Expo exposes only EXPO_PUBLIC_* variables to app code.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
EXPO_PUBLIC_SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Server-side only: configure in Supabase Edge Function secrets, never in the mobile app.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=REPLACE_IN_SECRET_STORE
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# AI_PROVIDER=your-provider
# AI_API_KEY=REPLACE_IN_SECRET_STORE
# AI_MODEL=server-configured-model
# AI_MAX_OUTPUT_TOKENS=500
# AI_DAILY_WORKSPACE_LIMIT=100
# AI_REQUESTS_PER_MINUTE=5

# Optional observability values; use only public/client-safe DSNs in the app.
# EXPO_PUBLIC_ERROR_REPORTING_DSN=
# EXPO_PUBLIC_ANALYTICS_KEY=

# Never add SUPABASE_SECRET_KEY or AI_API_KEY to EXPO_PUBLIC_* variables.
# .env is git-ignored; keep real credentials out of source control.
