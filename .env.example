# Copy this file to .env for the Expo app. Keep this file limited to public,
# client-safe values: Expo loads every .env variable into its dev-server process.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
EXPO_PUBLIC_SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Optional observability values; use only public/client-safe DSNs in the app.
# EXPO_PUBLIC_ERROR_REPORTING_DSN=
# EXPO_PUBLIC_ANALYTICS_KEY=
